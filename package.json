{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run sitemap && vite-react-ssg build",
    "build:dev": "vite build --mode development",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run validate && npm run build",
    "prepare": "husky",
    "validate": "node -e \"const t=require('./src/data/tools.json');const s=new Set();t.forEach((x,i)=>{const k=x.name.toLowerCase().replace(/[^a-z0-9]+/g,'-');if(s.has(k))throw new Error('DUPLICATE SLUG: '+k+' at index '+i);s.add(k);['name','category','subcategory','description','url','tags','pricing'].forEach(f=>{if(!x[f])throw new Error('MISSING: '+f+' at index '+i);});});console.log('✓ '+t.length+' tools valid, no duplicates');\""
  },
