# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Static-build scratch directories. The page generator writes these while it
# renders and normally clears them, but a failed or interrupted build leaves
# them behind, so they must never be committable.
.vite-react-ssg-temp/
.vite/
*.tsbuildinfo

# Output produced by running the tests. The test setup itself (playwright.config.ts,
# playwright-fixture.ts, src/test/) is committed; only what a run generates is ignored.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.playwright/
.playwright-mcp/
*.trace.zip

# Scratch space for anything a test run leaves behind
.scratch/
/tmp/
screenshots/

# Stray images at the repo root (committed assets live in public/ or src/)
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example

# Vercel local project metadata
.vercel

# Backup files
*.bak

# Claude Code local-only settings
.claude/settings.local.json
.mcp.json

# Local cert/key material
*.pem
*.key
*.crt
*.p12
*.pfx

# Generated from tools.json by the split step (rebuilt each dev/build)
src/data/tools-index.json
src/data/tools/
src/data/trust-related/
